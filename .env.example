APP_ENV=local
APP_URL=http://localhost:8080
APP_KEY=replace-with-at-least-32-random-characters
APP_SETUP_TOKEN=replace-with-a-long-random-one-time-setup-token
SESSION_NAME=nexum_admin_session
SESSION_LIFETIME=7200

MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=nexum_chatbot

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=notifications@example.com
SMTP_FROM_NAME=Nexum Chatbot
LEAD_NOTIFICATION_EMAIL=info@nexumglobal.solutions
