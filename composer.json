{
  "name": "nexum/chatbot-website",
  "description": "Nexum Chatbot website and MongoDB-backed PHP admin panel",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-ctype": "*",
    "ext-filter": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-mongodb": "^2.5",
    "ext-openssl": "*",
    "mongodb/mongodb": "^2.5",
    "phpmailer/phpmailer": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "Nexum\\": "src/"
    }
  },
  "scripts": {
    "build-assets": "php scripts/build-assets.php",
    "init-db": "php scripts/init-mongodb.php",
    "check": "php scripts/check.php"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
